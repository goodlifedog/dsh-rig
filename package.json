{
  "name": "dsh-rig",
  "version": "0.8.0",
  "private": false,
  "type": "module",
  "description": "DSH Rig：后台电脑控制装置——后台操作 macOS 真实应用、小窗实时回显，不抢焦点、不动鼠标",
  "license": "MIT",
  "author": "goodlifedog <goodlifedog@users.noreply.github.com>",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "macos",
    "desktop-automation",
    "computer-use",
    "accessibility",
    "background-control",
    "overlay",
    "acceptance-testing",
    "open-computer-use",
    "agent",
    "electron",
    "cli",
    "automation",
    "ui-automation",
    "ax"
  ],
  "scripts": {
    "status": "node core/status.mjs",
    "accept": "node core/acceptance.mjs",
    "list": "node core/runner.mjs list",
    "run": "node core/runner.mjs run",
    "daemon": "node core/cli.mjs start",
    "stop": "node core/cli.mjs stop",
    "agent": "node core/cli.mjs status",
    "task": "node core/cli.mjs run",
    "check": "node scripts/syntax-check.mjs",
    "overlay": "node overlay/start.mjs",
    "doctor": "node core/platform-smoke.mjs",
    "service:install": "node core/service.mjs install",
    "service:restart": "node core/service.mjs restart",
    "service:status": "node core/service.mjs status",
    "service:uninstall": "node core/service.mjs uninstall",
    "test": "node --test test/",
    "demo:platform": "node core/runner.mjs run platform-demo",
    "demo:concurrent": "node core/tasks/concurrent-demo.mjs",
    "setup": "npm install && npm install --prefix overlay",
    "repo:check": "node scripts/repo-check.mjs",
    "safety:audit": "node scripts/safety-audit.mjs",
    "restart:check": "node scripts/restart-check.mjs",
    "bench:ocu": "node scripts/bench-ocu.mjs 4",
    "check:ocu": "node scripts/check-ocu.mjs",
    "start": "node scripts/start-all.mjs",
    "ui:regression": "node scripts/ui-regression.mjs",
    "scope:check": "node scripts/session-scope-check.mjs",
    "soak": "node scripts/soak.mjs",
    "fps:check": "node scripts/fps-check.mjs",
    "monitor": "node scripts/monitor.mjs",
    "trends": "node scripts/trends.mjs",
    "verify": "npm run check && npm test && npm run repo:check",
    "humanize:live": "node scripts/humanize-live.mjs",
    "matrix": "node core/tasks/app-matrix.mjs",
    "apps:inventory": "node scripts/app-inventory.mjs",
    "dialogs:guard": "node core/dialog-guard.mjs",
    "prune": "node scripts/prune.mjs",
    "cleanup:test": "node scripts/cleanup-test-data.mjs",
    "apps:probe": "node scripts/apps-probe.mjs",
    "app:runtime": "node scripts/app-runtime.mjs",
    "app:resolve": "node scripts/app-resolve.mjs",
    "cdp:apps": "node core/tasks/cdp-driver.mjs",
    "cdp:channel": "node core/tasks/cdp-channel.mjs",
    "as:channel": "node core/tasks/applescript-channel.mjs",
    "stability": "node core/tasks/background-stability.mjs",
    "browser:bg": "node core/tasks/browser-background.mjs",
    "cold:launch": "node core/tasks/cold-launch.mjs",
    "user:active": "node core/tasks/user-active-demo.mjs",
    "terminal:bg": "node core/tasks/terminal-control.mjs",
    "agent:drive": "node core/tasks/drive-agent.mjs",
    "agent:cli": "node core/tasks/drive-agent-cli.mjs",
    "bg:verify": "node scripts/bg-verify.mjs",
    "ui:check": "node scripts/ui-check.mjs",
    "health": "node scripts/health.mjs",
    "verify:live": "node scripts/live-verify.mjs",
    "verify:safe": "node scripts/verify-safe.mjs",
    "front:risk": "node scripts/front-risk.mjs",
    "tasks:doc": "node scripts/tasks-doc.mjs",
    "env:doc": "node scripts/env-doc.mjs",
    "away:maintain": "node scripts/away-maintenance.mjs",
    "permissions:open": "node scripts/open-permissions.mjs"
  },
  "homepage": "https://github.com/goodlifedog/dsh-rig#readme",
  "bin": {
    "dsh-rig": "./core/cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/goodlifedog/dsh-rig.git"
  },
  "bugs": {
    "url": "https://github.com/goodlifedog/dsh-rig/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "dependencies": {
    "electron": "^41.7.1",
    "open-computer-use": "^1.1.3"
  },
  "files": [
    "core/",
    "overlay/",
    "scripts/",
    "examples/",
    "README.md",
    "ARCHITECTURE.md",
    "CAPABILITIES.md",
    "CHANGELOG.md",
    "THIRD-PARTY.md",
    "LICENSE",
    "docs/USAGE.md",
    "docs/MAC-APPS.md",
    "docs/SECURITY.md",
    "docs/ADAPTERS.md",
    "docs/APP-SUPPORT-ARCHITECTURE.md",
    "third_party/open-computer-use/LICENSE",
    "third_party/open-computer-use/NOTICE.md",
    "third_party/open-computer-use/THIRD_PARTY_NOTICES.md",
    "!overlay/node_modules/**",
    "!overlay/docs/**",
    "!third_party/open-computer-use/bin/**",
    "!third_party/open-computer-use/dist/**",
    "!third_party/open-computer-use/scripts/**"
  ]
}
