{
  "name": "desktop-agent",
  "version": "0.7.0",
  "private": false,
  "type": "module",
  "description": "后台电脑控制 + 小窗回显：用 Accessibility 语义树驱动真实 macOS 应用，全程不抢焦点",
  "license": "MIT",
  "author": "goodlifedog",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "macos",
    "windows",
    "accessibility",
    "computer-use",
    "open-computer-use",
    "mcp",
    "automation",
    "electron",
    "overlay"
  ],
  "scripts": {
    "status": "node core/status.mjs",
    "accept": "node core/acceptance.mjs",
    "list": "node core/runner.mjs list",
    "run": "node core/runner.mjs run",
    "daemon": "node core/cli.mjs start",
    "stop": "node core/cli.mjs stop",
    "agent": "node core/cli.mjs status",
    "task": "node core/cli.mjs run",
    "check": "node scripts/syntax-check.mjs",
    "overlay": "node overlay/start.mjs",
    "doctor": "node core/platform-smoke.mjs",
    "service:install": "node core/service.mjs install",
    "service:uninstall": "node core/service.mjs uninstall",
    "test": "node --test test/",
    "demo:platform": "node core/runner.mjs run platform-demo",
    "setup": "npm install && npm install --prefix overlay",
    "repo:check": "node scripts/repo-check.mjs",
    "restart:check": "node scripts/restart-check.mjs",
    "bench:ocu": "node scripts/bench-ocu.mjs 4",
    "check:ocu": "node scripts/check-ocu.mjs",
    "start": "node scripts/start-all.mjs",
    "ui:regression": "node scripts/ui-regression.mjs",
    "scope:check": "node scripts/session-scope-check.mjs",
    "soak": "node scripts/soak.mjs",
    "fps:check": "node scripts/fps-check.mjs",
    "monitor": "node scripts/monitor.mjs",
    "ui:check": "node scripts/ui-check.mjs",
    "health": "node scripts/health.mjs"
  }
}
