   console.log('overlay 7788 监听者：' + (overlayListener.pid || '无') + '，launchd 受管 pid：' + (overlayManaged || '无') + '，部署状态：' + overlayDrift);
+  // 代码新鲜度：改了直接依赖却没重启时，上面的「部署状态」照样是 ok，这里补一句提醒
