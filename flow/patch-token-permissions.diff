diff --git a/test/token-perm.test.mjs b/test/token-perm.test.mjs
new file mode 100644
index 0000000..b71443a
--- /dev/null
+++ b/test/token-perm.test.mjs
@@ -0,0 +1,38 @@
+'use strict';
+// 权限校正：老版本/备份恢复出来的 755/644 应当被纠正回 700/600。
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+import os from 'node:os';
+import path from 'node:path';
+import { createRequire } from 'node:module';
+
+const require = createRequire(import.meta.url);
+const { ensureTokenSync } = require('../core/local-token.cjs');
+
+function modeOf(p) {
+  return fs.statSync(p).mode & 0o777;
+}
+
+test('已有合法 token 但权限过宽：会被收紧到 600/700', () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tokperm-'));
+  const file = path.join(dir, 'api-token');
+  fs.writeFileSync(file, 'a'.repeat(64) + '\n');
+  fs.chmodSync(file, 0o644);
+  fs.chmodSync(dir, 0o755);
+  const token = ensureTokenSync(file);
+  assert.equal(token, 'a'.repeat(64), '应复用已有 token，不重新生成');
+  assert.equal(modeOf(file), 0o600, 'token 文件应收紧到 600');
+  assert.equal(modeOf(dir), 0o700, '数据目录应收紧到 700');
+  fs.rmSync(dir, { recursive: true, force: true });
+});
+
+test('首次生成时目录和文件权限就是 700/600', () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'tokperm2-'));
+  const file = path.join(dir, 'sub', 'api-token');
+  const token = ensureTokenSync(file);
+  assert.equal(token.length >= 64, true);
+  assert.equal(modeOf(file), 0o600);
+  assert.equal(modeOf(path.dirname(file)), 0o700);
+  fs.rmSync(dir, { recursive: true, force: true });
+});
