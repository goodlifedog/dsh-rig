diff --git a/test/form-fill-script.test.mjs b/test/form-fill-script.test.mjs
new file mode 100644
index 0000000..6f87509
--- /dev/null
+++ b/test/form-fill-script.test.mjs
@@ -0,0 +1,28 @@
+'use strict';
+// form-fill 生成的页面脚本：恢复用户原值必须在 finally 里，异常也不能留在测试值上。
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { buildFill } from '../core/tasks/form-fill.mjs';
+
+const script = buildFill();
+
+test('生成的脚本把恢复放进 finally', () => {
+  const idxFinally = script.indexOf('} finally {');
+  const idxRestore = script.indexOf('writeValue(out.original, "restore")');
+  const idxSetNew = script.indexOf('writeValue(NEWVAL, "setNew")');
+  assert.ok(idxSetNew > 0, '应包含 setNew 写入');
+  assert.ok(idxFinally > 0, '应有 finally 块');
+  assert.ok(idxRestore > idxFinally, '恢复必须在 finally 之后执行');
+  assert.ok(idxSetNew < idxFinally, 'setNew 在 try 里、finally 之前');
+});
+
+test('恢复失败被单独捕获，不会把整段脚本炸掉', () => {
+  assert.match(script, /catch \(restoreError\)/);
+  assert.match(script, /out\.restored = false/);
+});
+
+test('脚本里仍然包含原来的断言字段', () => {
+  for (const key of ['out.original', 'out.valueAfterNew', 'out.valueAfterRestore', 'out.ok']) {
+    assert.ok(script.includes(key), '缺少 ' + key);
+  }
+});
