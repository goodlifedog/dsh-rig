diff --git a/overlay/session-gate.js b/overlay/session-gate.js
index 5f14678..d7be95a 100644
--- a/overlay/session-gate.js
+++ b/overlay/session-gate.js
@@ -24,7 +24,13 @@ function matchesTitle(titleHint, hostTitle, suffix) {
   const host = normalizeHostTitle(hostTitle, suffix);
   const hint = normalizeHostTitle(titleHint, suffix);
   if (!hint) return true;
-  return host.indexOf(hint) !== -1;
+  if (host === hint) return true;
+  // 不能用裸子串：会话「规划布局探讨」会匹配到「规划布局探讨（二）」，两个会话互相点亮小窗。
+  // 但宿主标题可能带装饰（状态点、未读标记），所以允许「去掉 hint 后只剩标点/符号/空白」。
+  const at = host.indexOf(hint);
+  if (at < 0) return false;
+  const rest = host.slice(0, at) + host.slice(at + hint.length);
+  return /^[\s\p{P}\p{S}]*$/u.test(rest);
 }
 
 module.exports = { normalizeHostTitle, normalizeDshTitle, matchesTitle, DEFAULT_SUFFIX };
diff --git a/test/session-gate.test.mjs b/test/session-gate.test.mjs
index 3275145..07bc2b9 100644
--- a/test/session-gate.test.mjs
+++ b/test/session-gate.test.mjs
@@ -37,3 +37,16 @@ test('hint 传完整窗口标题也能匹配', () => {
   assert.equal(matchesTitle('  规划布局探讨  ', dsh), true);
   assert.equal(matchesTitle('另一个会话 — DeepSeek Harness', dsh), false);
 });
+
+test('名字相近的两个会话不能互相点亮（前缀/包含关系不算命中）', () => {
+  const dsh = '规划布局探讨 — DeepSeek Harness';
+  assert.equal(matchesTitle('规划布局探讨（二）', dsh), false, '别的会话多了后缀，不该匹配');
+  assert.equal(matchesTitle('规划布局探讨', '规划布局探讨（二） — DeepSeek Harness'), false, '反过来也不该匹配');
+  assert.equal(matchesTitle('规划布局探讨', '旧规划布局探讨记录 — DeepSeek Harness'), false, '包含关系不算命中');
+  assert.equal(matchesTitle('项目', '项目详情 — DeepSeek Harness'), false, '短标题不能命中长标题');
+});
+
+test('宿主标题带装饰（状态点/标点）仍然算同一个会话', () => {
+  assert.equal(matchesTitle('规划布局探讨', '● 规划布局探讨 — DeepSeek Harness'), true);
+  assert.equal(matchesTitle('规划布局探讨', '规划布局探讨 · — DeepSeek Harness'), true);
+});
