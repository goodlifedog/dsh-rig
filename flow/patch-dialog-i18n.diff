diff --git a/test/dialog-i18n.test.mjs b/test/dialog-i18n.test.mjs
new file mode 100644
index 0000000..ac5a715
--- /dev/null
+++ b/test/dialog-i18n.test.mjs
@@ -0,0 +1,33 @@
+'use strict';
+// 权限弹窗识别必须覆盖非中英文系统：漏一种语言就等于允许代点授权。
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { classifyDialog } from '../core/dialog-guard.mjs';
+
+const CASES = [
+  ['德语', 'Systemeinstellungen möchte Bedienungshilfen steuern. Erlauben?'],
+  ['法语', 'Réglages Système : Accessibilité — Autoriser ?'],
+  ['日语', 'システム設定がアクセシビリティへのアクセスを求めています。許可しますか？'],
+  ['英语', 'System Settings wants to control Accessibility. Allow?'],
+  ['中文', '系统设置想要控制「辅助功能」。允许？'],
+];
+
+test('多语言权限弹窗：一律不代点', () => {
+  for (const [name, text] of CASES) {
+    const r = classifyDialog(text, ['允许', 'Erlauben', 'OK']);
+    assert.equal(r.kind, 'permission', name);
+    assert.equal(r.autoClick, false, name);
+  }
+});
+
+test('文字认不出但出现授予类按钮：仍按权限处理（结构兜底）', () => {
+  const r = classifyDialog('Unbekannter Dialog', ['Erlauben', 'Abbrechen']);
+  assert.equal(r.kind, 'permission');
+  assert.equal(r.autoClick, false);
+});
+
+test('普通弹窗（只有安全按钮）仍可自动点', () => {
+  const r = classifyDialog('保存失败，请重试', ['确定']);
+  assert.equal(r.kind, 'benign');
+  assert.equal(r.autoClick, true);
+});
